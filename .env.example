# Sanity — the content store.
NEXT_PUBLIC_SANITY_PROJECT_ID=pfyla0cp
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Write token. Needed by `npm run seed` and by /admin. Never commit the value.
SANITY_API_WRITE_TOKEN=

# Shared secret the Sanity webhook sends to /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Single-editor admin password. Unset leaves /admin closed.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
